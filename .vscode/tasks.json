{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Commit staged changes with changelog",
			"type": "process",
			"command": "npm",
			"windows": { "command": "npm.cmd" },
			"args": ["run", "commit", "--", "${input:commitMessage}"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "commitMessage",
			"type": "promptString",
			"description": "Commit message (also recorded in changelog.md)"
		}
	]
}
